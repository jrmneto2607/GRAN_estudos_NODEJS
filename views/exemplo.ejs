<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exemplo</title>
</head>
<body>
    <table border="1">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Idade</th>
            </tr>
        </thead>
        <tbody>
            <% for(let pessoa of pessoas) { %>
            <tr>
                <td><%= pessoa.nome %></td>
                <td><%= pessoa.idade %></td>
            </tr>
            <% } %>
        </tbody>
    </table>
</body>
</html>